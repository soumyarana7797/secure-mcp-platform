FOOTBALL_DATA_API_TOKEN=dev-token
FOOTBALL_DATA_API_URL=http://127.0.0.1:9001

# --- database (local dev values only; real values come from Secrets Manager in AWS) ---
POSTGRES_PASSWORD=dev-owner-password
GATEWAY_APP_PASSWORD=dev-app-password
# Owner role: migrations and the admin CLI only.
GATEWAY_MIGRATION_DATABASE_URL=postgresql://postgres:dev-owner-password@127.0.0.1:5432/gateway
# Runtime role: what the gateway connects as (cannot bypass row-level security).
GATEWAY_DATABASE_URL=postgresql://gateway_app:dev-app-password@127.0.0.1:5432/gateway

# --- gateway auth (Phase 3). "disabled" rejects all MCP requests. "dev_header" trusts an
# X-Dev-Sub header and is refused unless GATEWAY_ENVIRONMENT=local. Cognito arrives in Phase 4.
# GATEWAY_AUTH_MODE=dev_header
